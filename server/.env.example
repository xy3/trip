# Copy to server/.env and fill in. Everything is optional except the Google
# OAuth credentials — without them the server still serves the app, just
# without sign-in and sync.

# Public origin the browser sees. Must match the OAuth redirect URIs exactly.
BASE_URL=https://trip.example.com
PORT=8123
HOST=0.0.0.0

# Where the SQLite file lives (created on first run, with -wal/-shm beside it)
DB_FILE=./server/data/trip.db

# Google  — console.cloud.google.com → APIs & Services → Credentials
#   OAuth client type: Web application
#   Authorised redirect URI: {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Limits
SESSION_DAYS=90
MAX_BLOB_BYTES=26214400
QUOTA_BYTES=786432000
